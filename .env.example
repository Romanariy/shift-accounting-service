APP_DOMAIN=:80

POSTGRES_DB=shift_accounting
POSTGRES_USER=shift_accounting
POSTGRES_PASSWORD=change-this-postgres-password

DJANGO_SECRET_KEY=change-this-django-secret-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_CONN_MAX_AGE=60

TELEGRAM_BOT_TOKEN=
SHIFT_SYNC_ENDPOINT=
SHIFT_SYNC_TOKEN=
SHIFT_SYNC_AFTER_WRITE=1
SHIFT_SYNC_INTERVAL=3600

DJANGO_API_BASE_URL=http://backend:8000

SITE_BASIC_AUTH_USER=admin
SITE_BASIC_AUTH_PASSWORD_HASH='$2a$14$replace-this-with-caddy-hash-password-output'
